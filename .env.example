# ─── PostgreSQL ───────────────────────────────────────────────
POSTGRES_DB=greenbusinesssuite
POSTGRES_USER=gbs_user
POSTGRES_PASSWORD=change-me-strong-password

# ─── pgAdmin (db.greenbusinesssuite.com) ──────────────────────
PGADMIN_DEFAULT_EMAIL=admin@greenbusinesssuite.com
PGADMIN_DEFAULT_PASSWORD=change-me-pgadmin-password

# ─── Spring Boot ──────────────────────────────────────────────
SERVER_PORT=8081
DDL_AUTO=none
FLYWAY_ENABLED=true
FLYWAY_BASELINE_ON_MIGRATE=true

JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRATION_MS=86400000

# ─── Email ────────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=

# ─── Payments ─────────────────────────────────────────────────
PAYMENT_CLIENT_SECRET=
PAYMENT_CLIENT_ID=
PAYMENT_SERVICE_ID=
PAYMENT_CALLBACK_URL=https://api.greenbusinesssuite.com/mesh-suite/v1.0/payments/trigger/callback

# ─── Contabo / S3 storage ─────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-central-1
AWS_BUCKET_NAME=
AWS_ENDPOINT=
